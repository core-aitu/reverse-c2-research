{
  "name": "specter-research-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "test:docs": "node --test tests/documentation.test.mjs",
    "test:replay": "node --test tests/measurementReplay.test.mjs",
    "test:plugins": "node --test tests/researchPlugins.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
