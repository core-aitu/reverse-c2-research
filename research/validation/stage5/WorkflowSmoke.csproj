    <Reference Include="Microsoft.AspNetCore.SignalR.Client"><HintPath>$(Dist)/client/Microsoft.AspNetCore.SignalR.Client.dll</HintPath></Reference>
    <Reference Include="Microsoft.AspNetCore.SignalR.Client.Core"><HintPath>$(Dist)/client/Microsoft.AspNetCore.SignalR.Client.Core.dll</HintPath></Reference>
    <Reference Include="Microsoft.AspNetCore.Http.Connections.Client"><HintPath>$(Dist)/client/Microsoft.AspNetCore.Http.Connections.Client.dll</HintPath></Reference>
